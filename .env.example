# Example environment file. Copy to ".env" and fill in your own values:
#   cp .env.example .env
# .env is loaded automatically (and is gitignored) - see cli.py's load_dotenv() call.
# Only needed for --backend hms; the default local backend needs none of this.

# Base URL of the HMS-provisioned inference service (see
# https://github.com/ccb-hms/LocalAiInferenceService). Requires the HMS VPN.
HMS_API_ENDPOINT=https://ai-poc.hms.edu

# Which model to request from it. muse-glimmer is the one model the service
# advertises as of this writing; GET https://ai-poc.hms.edu/v1/models lists
# what's actually available if that's changed.
HMS_MODEL=muse-glimmer

# Credentials - set ONE of the two options below.

# Option A (recommended): a short-lived access token, obtained without ever
# putting your HMS password in this file. Clone the repo (gh CLI avoids
# needing an SSH key set up for GitHub):
#   gh repo clone ccb-hms/LocalAiInferenceService
# then, inside it:
#   ./get-okta-token.sh
# and paste the printed token here. It expires (typically within an hour) -
# when requests start failing with "the request / rejected (401/403)", the
# app's error message says so; re-run the script, update this file, and
# restart the app (it only reads this token once, at startup).
# HMS_API_TOKEN=<paste the token from get-okta-token.sh>

# Option B: let this app fetch a token itself via your HMS username/password
# (the same Okta password grant get-okta-token.sh uses under the hood) -
# simpler, but means your password sits in this file. Your HMS username is
# not your email - find it at https://login.hms.harvard.edu/account-settings/profile.
# HMS_USERNAME=<your HMS username, e.g. USER123@MED.HARVARD.EDU>
# HMS_PASSWORD=<your HMS password>
